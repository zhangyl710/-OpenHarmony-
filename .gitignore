node_modules/
oh_modules/

# ═══════════════ 构建产物 ═══════════════
build/
.hvigor/
.preview/
.cxx/
.test/
previewer/
*.hap
*.hsp
*.app
*.har
*.abc
*.map

# ═══════════════ 大体积二进制 ═══════════════
