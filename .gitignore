*.npz
*.ckpt
*.mindir
*.onnx
*.pt
*.pth

# ═══════════════ IDE ═══════════════
.idea/
.vscode/
*.iml
local.properties
oh-package-lock.json5

# ═══════════════ 操作系统 ═══════════════
.DS_Store
Thumbs.db
desktop.ini

# ═══════════════ 日志与临时文件 ═══════════════
*.log
*.tmp
*.bak
*~
~$*

# ═══════════════ 签名与私钥 ═══════════════
*.p12
*.cer
*.p7b
*.jks
signing/

# ═══════════════ 暂不上传 ═══════════════
